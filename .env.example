FILES2MD_HOST=127.0.0.1
FILES2MD_PORT=8000
FILES2MD_DATA_DIR=./data
FILES2MD_MAX_UPLOAD_MB=200
FILES2MD_JOB_TTL_HOURS=24
FILES2MD_JOB_TIMEOUT_S=600
FILES2MD_QUEUE_BACKEND=inprocess
FILES2MD_QUEUE_WORKERS=2
# Vacío = sin auth (solo aceptable en 127.0.0.1)
FILES2MD_API_TOKEN=
# Motores pesados: apagados por defecto
FILES2MD_ENABLE_OCR=false
FILES2MD_ENABLE_VLM=false
FILES2MD_VLM_ENDPOINT=
