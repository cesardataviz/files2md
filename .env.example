FILES2MD_HOST=127.0.0.1
FILES2MD_PORT=8000
FILES2MD_DATA_DIR=./data
FILES2MD_MAX_UPLOAD_MB=200
FILES2MD_JOB_TTL_HOURS=24
FILES2MD_JOB_TIMEOUT_S=600
FILES2MD_QUEUE_BACKEND=inprocess
FILES2MD_QUEUE_WORKERS=2
# Vacío = sin auth (solo aceptable en 127.0.0.1)
FILES2MD_API_TOKEN=
# OCR con Tesseract (activo; si no está instalado, el job lo indica)
FILES2MD_ENABLE_OCR=true
# Ruta al ejecutable si no está en el PATH. Windows típico:
# FILES2MD_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
FILES2MD_TESSERACT_CMD=
FILES2MD_OCR_LANGS=spa+eng
FILES2MD_OCR_DPI=300
# VLM: apagado por defecto
FILES2MD_ENABLE_VLM=false
FILES2MD_VLM_ENDPOINT=
